{
  "name": "@engios/dsh-feature-dev",
  "version": "0.1.5",
  "description": "Native MRD-to-code workflow bundle for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/types/index.d.ts"
    }
  },
  "files": [
    "lib",
    "CHANGELOG.md",
    "cordis.patch.yml",
    "skills",
    "agents",
    "rules",
    "templates",
    "scripts",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "test": "node --test --import tsx tests/unit/*.test.ts tests/contract/*.test.ts",
    "test:unit": "node --test --import tsx tests/unit/*.test.ts",
    "test:contract": "node --test --import tsx tests/contract/*.test.ts",
    "test:integration": "node --test --import tsx tests/integration/*.test.ts",
    "test:scan": "node --import tsx scripts/scan-claude-keywords.ts",
    "test:package": "node --import tsx scripts/verify-package.ts",
    "verify:dsh": "node --import tsx scripts/verify-dsh-versions.ts",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('lib',{recursive:true,force:true}))\"",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "repository": {
    "type": "git",
    "url": "http://gitlab.iheatingos.com:8083/engios/dsh-feature-dev.git"
  },
  "bugs": {
    "url": "http://gitlab.iheatingos.com:8083/engios/dsh-feature-dev/-/issues"
  },
  "homepage": "http://gitlab.iheatingos.com:8083/engios/dsh-feature-dev#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.1",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1",
    "@deepseek-ai/dsh-subagent": ">=0.1.0-rc.1",
    "@deepseek-ai/dsh-workflow": ">=0.1.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-workflow": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
