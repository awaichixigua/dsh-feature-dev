{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-feature-dev.local/schemas/invocation.schema.json",
  "title": "FeatureDevInvocation",
  "type": "object",
  "required": ["workflow", "projectRoot", "options"],
  "additionalProperties": false,
  "properties": {
    "workflow": {
      "type": "string",
      "enum": [
        "mrd-to-code",
        "knowledge-base",
        "implementation-plan",
        "code-gen-tdd",
        "bugfix",
        "archive",
        "prd-clarify",
        "influence-menu"
      ]
    },
    "projectRoot": { "type": "string", "minLength": 1 },
    "featureDir": { "type": "string" },
    "featureId": { "type": "string" },
    "target": { "type": "string" },
    "mrdUrl": { "type": "string", "format": "uri", "description": "implementation-plan 可选；未提供时使用 rawUserRequest 作为直接需求" },
    "bugDescription": { "type": "string" },
    "rawUserRequest": { "type": "string" },
    "options": {
      "type": "object",
      "required": ["resume", "unitTests", "generateUnitTestsOnly"],
      "additionalProperties": false,
      "properties": {
        "resume": { "type": "boolean" },
        "unitTests": { "type": "boolean" },
        "skipUnitTests": { "type": "boolean" },
        "generateUnitTestsOnly": { "type": "boolean" },
        "clarifyMode": { "type": "string", "enum": ["dialogue", "batch"] },
        "skipMrdClarify": { "type": "boolean" },
        "singlePhase": { "type": "string" },
        "autoCommit": { "type": "boolean", "description": "--auto-comit：成功完成后自动 git add --all、commit 并 push" }
      }
    },
    "modelOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "planning": { "type": "object" },
        "coding": { "type": "object" },
        "review": { "type": "object" },
        "summary": { "type": "object" }
      }
    }
  }
}
